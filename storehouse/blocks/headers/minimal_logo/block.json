{
  "id": "headers/minimal_logo",
  "category": "header",
  "description": "Small, simple Serenity Blooms logo header for visually light emails.",
  "products": [
    "all"
  ],
  "campaigns": [
    "homecoming"
  ],
  "elements": [
    {
      "element": "logo_url",
      "type": "image_url",
      "required": true
    },
    {
      "element": "logo_alt",
      "type": "text",
      "required": true,
      "cap_chars": 120
    },
    {
      "element": "logo_width",
      "type": "number",
      "required": false
    },
    {
      "element": "background_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.section_background"
    },
    {
      "element": "text_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.body_text"
    },
    {
      "element": "body_font",
      "type": "font",
      "required": true,
      "source": "brand_profile.font_options.body"
    }
  ],
  "email_safe": true,
  "layout": "single_column",
  "can_follow": [
    "start"
  ],
  "can_precede": [
    "hero",
    "content",
    "product",
    "cta",
    "footer"
  ],
  "composition_rules": {
    "top_level_only": true,
    "nestable": false,
    "render_order": "top_to_bottom"
  },
  "brand_styling": {
    "source": "brand_profile",
    "guidance": "Choose only approved brand values from the source paths listed in the styling elements before rendering this block."
  }
}
