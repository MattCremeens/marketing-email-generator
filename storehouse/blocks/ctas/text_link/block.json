{
  "id": "ctas/text_link",
  "category": "cta",
  "description": "Minimal text-link CTA for secondary ordering or contact actions.",
  "products": [
    "pocket squares",
    "bouquets",
    "boutonnieres"
  ],
  "campaigns": [
    "homecoming"
  ],
  "elements": [
    {
      "element": "cta_text",
      "type": "text",
      "required": true,
      "cap_chars": 50
    },
    {
      "element": "cta_url",
      "type": "url",
      "required": true
    },
    {
      "element": "background_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.section_background"
    },
    {
      "element": "body_font",
      "type": "font",
      "required": true,
      "source": "brand_profile.font_options.body"
    },
    {
      "element": "accent_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.accent"
    }
  ],
  "email_safe": true,
  "layout": "single_column",
  "can_follow": [
    "hero",
    "content",
    "product"
  ],
  "can_precede": [
    "content",
    "product",
    "footer"
  ],
  "composition_rules": {
    "top_level_only": true,
    "nestable": false,
    "render_order": "top_to_bottom"
  },
  "brand_styling": {
    "source": "brand_profile",
    "guidance": "Choose only approved brand values from the source paths listed in the styling elements before rendering this block."
  }
}
