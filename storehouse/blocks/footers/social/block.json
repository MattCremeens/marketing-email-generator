{
  "id": "footers/social",
  "category": "footer",
  "description": "Serenity Blooms footer with business information and optional social links.",
  "products": [
    "all"
  ],
  "campaigns": [
    "homecoming"
  ],
  "elements": [
    {
      "element": "business_name",
      "type": "text",
      "required": true,
      "cap_chars": 80
    },
    {
      "element": "contact_text",
      "type": "text",
      "required": true,
      "cap_chars": 160
    },
    {
      "element": "socials",
      "type": "repeating_group",
      "required": false,
      "count": "variable",
      "elements": [
        {
          "element": "label",
          "type": "text",
          "cap_chars": 30
        },
        {
          "element": "url",
          "type": "url"
        }
      ]
    },
    {
      "element": "background_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.section_background"
    },
    {
      "element": "text_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.body_text"
    },
    {
      "element": "body_font",
      "type": "font",
      "required": true,
      "source": "brand_profile.font_options.body"
    },
    {
      "element": "heading_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.heading_text"
    },
    {
      "element": "heading_font",
      "type": "font",
      "required": true,
      "source": "brand_profile.font_options.heading"
    },
    {
      "element": "accent_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.accent"
    }
  ],
  "email_safe": true,
  "layout": "single_column",
  "can_follow": [
    "header",
    "hero",
    "content",
    "product",
    "cta"
  ],
  "can_precede": [
    "end"
  ],
  "composition_rules": {
    "top_level_only": true,
    "nestable": false,
    "render_order": "top_to_bottom"
  },
  "brand_styling": {
    "source": "brand_profile",
    "guidance": "Choose only approved brand values from the source paths listed in the styling elements before rendering this block."
  }
}
