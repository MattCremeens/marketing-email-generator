{
  "id": "footers/social",
  "category": "footer",
  "description": "Serenity Blooms footer with business information and optional social links.",
  "products": [
    "all"
  ],
  "campaigns": [
    "homecoming"
  ],
  "elements": [
    {
      "element": "business_name",
      "type": "text",
      "required": true,
      "cap_chars": 80
    },
    {
      "element": "contact_text",
      "type": "text",
      "required": true,
      "cap_chars": 160
    },
    {
      "element": "socials",
      "type": "repeating_group",
      "required": false,
      "count": "variable",
      "elements": [
        {
          "element": "label",
          "type": "text",
          "cap_chars": 30
        },
        {
          "element": "url",
          "type": "url"
        }
      ]
    }
  ],
  "email_safe": true,
  "layout": "single_column",
  "can_follow": [
    "header",
    "hero",
    "content",
    "product",
    "cta"
  ],
  "can_precede": [
    "end"
  ],
  "composition_rules": {
    "top_level_only": true,
    "nestable": false,
    "render_order": "top_to_bottom"
  }
}
