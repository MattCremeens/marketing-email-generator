{
  "id": "content/centered_text",
  "category": "content",
  "description": "Centered text block for event details, ordering notes, or flower information.",
  "products": [
    "pocket squares",
    "bouquets",
    "boutonnieres"
  ],
  "campaigns": [
    "homecoming"
  ],
  "elements": [
    {
      "element": "headline",
      "type": "text",
      "required": true,
      "cap_chars": 70
    },
    {
      "element": "body",
      "type": "text",
      "required": true,
      "cap_chars": 350
    },
    {
      "element": "background_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.section_background"
    },
    {
      "element": "text_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.body_text"
    },
    {
      "element": "body_font",
      "type": "font",
      "required": true,
      "source": "brand_profile.font_options.body"
    },
    {
      "element": "heading_color",
      "type": "color",
      "required": true,
      "source": "brand_profile.color_options.heading_text"
    },
    {
      "element": "heading_font",
      "type": "font",
      "required": true,
      "source": "brand_profile.font_options.heading"
    }
  ],
  "email_safe": true,
  "layout": "single_column",
  "can_follow": [
    "header",
    "hero",
    "content",
    "product"
  ],
  "can_precede": [
    "content",
    "product",
    "cta",
    "footer"
  ],
  "composition_rules": {
    "top_level_only": true,
    "nestable": false,
    "render_order": "top_to_bottom"
  },
  "brand_styling": {
    "source": "brand_profile",
    "guidance": "Choose only approved brand values from the source paths listed in the styling elements before rendering this block."
  }
}
