{
  "id": "products/single_feature",
  "category": "product",
  "description": "Single featured flower product with image, description, and CTA.",
  "products": [
    "pocket squares",
    "bouquets",
    "boutonnieres"
  ],
  "campaigns": [
    "homecoming"
  ],
  "elements": [
    {
      "element": "image_url",
      "type": "image_url",
      "required": true
    },
    {
      "element": "alt_text",
      "type": "text",
      "required": true,
      "cap_chars": 120
    },
    {
      "element": "product_name",
      "type": "text",
      "required": true,
      "cap_chars": 60
    },
    {
      "element": "description",
      "type": "text",
      "required": true,
      "cap_chars": 220
    },
    {
      "element": "cta_text",
      "type": "text",
      "required": false,
      "cap_chars": 30
    },
    {
      "element": "cta_url",
      "type": "url",
      "required": false
    }
  ],
  "email_safe": true,
  "layout": "single_column",
  "can_follow": [
    "header",
    "hero",
    "content",
    "product"
  ],
  "can_precede": [
    "content",
    "product",
    "cta",
    "footer"
  ],
  "composition_rules": {
    "top_level_only": true,
    "nestable": false,
    "render_order": "top_to_bottom"
  }
}
